{
  "name": "simple-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "push-worker"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run env:check && npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests scripts push-worker/src push-worker/test public/sw.js vite.config.ts vitest.rules.config.ts push-worker/vitest.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only database --project demo-simple-games \"vitest run --config vitest.rules.config.ts\"",
    "push:dev": "npm run dev --workspace push-worker",
    "push:types": "npm run types --workspace push-worker",
    "push:typecheck": "npm run typecheck --workspace push-worker",
    "push:test": "npm test --workspace push-worker",
    "push:check": "npm run check --workspace push-worker",
    "emulators": "firebase emulators:start --only auth,database --project demo-simple-games",
    "emulators:seed": "node scripts/seed-emulator.mjs",
    "seed:validate": "node scripts/seed-emulator.mjs --validate-only",
    "release-notes:check": "node scripts/check-release-notes.mjs",
    "env:check": "node scripts/check-env.mjs production",
    "check": "npm run lint && npm run typecheck && npm run push:check && npm run seed:validate && npm run release-notes:check && npm run test && npm run test:rules && npm run env:check && vite build"
  },
  "dependencies": {
    "firebase": "12.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "firebase-tools": "15.24.0",
    "jsdom": "29.1.1",
    "oxlint": "1.75.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "re2@1.26.1": true,
    "workerd@1.20260722.1": true
  }
}
