{
  "name": "simple-games-push-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "oxlint src test vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "npm run test -- --coverage",
    "wrangler:types:check": "npm run production:wrangler:types:generate -- --check",
    "check": "npm run lint && npm run typecheck && npm run wrangler:types:check && npm run test",
    "production:wrangler:types:generate": "wrangler types --env production --strict-vars false",
    "production:deploy": "npm run check && wrangler deploy --env production",
    "dev:start": "wrangler dev --env development"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^24.13.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
